# 특정 경로(?routeName) 위·옆(100m 이내)의 휴게·운동시설
# 예: ?routeName = "오산천길"@ko
PREFIX dt: <https://romanryu-rgb.github.io/dongtan-walk-map/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?facility ?type ?name WHERE {
  ?route a ?rc ; rdfs:label ?routeName ; dt:hasRouteFacility ?facility .
  VALUES ?rc { dt:WalkingTrail dt:RunningCourse dt:BikePath }
  ?facility a ?type . VALUES ?type { dt:RestFacility dt:ExerciseFacility }
  OPTIONAL { ?facility rdfs:label ?name }
}
